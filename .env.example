# Atlas Assessment — environment variables.
#
# Copy to .env.local for development:
#   cp .env.example .env.local
# Then fill in the values (see comments). Never commit .env.local.
#
# In production, set these in Vercel project settings (separate values
# per environment per architecture.md decision #4).

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Public — exposed to browser bundles. Safe to ship.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Used by admin and job code (e.g., serving
# questions one-at-a-time per compliance.md §8). NEVER expose to the
# browser. Do not import from any client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Canonical public origin (ATLAS-011) — REQUIRED wherever auth email is sent
# ---------------------------------------------------------------------------
#
# The origin every auth-email link is built on: signup confirmation, password
# reset, and the admin/student links inside staff notification emails.
#
# This USED to be derived from the request's Origin/Referer headers, which a
# caller controls — a forged header made Supabase mail a victim a confirmation
# or password-reset link pointing at an attacker's domain. There is deliberately
# NO header fallback now: if this is unset or malformed the send FAILS rather
# than silently going back to trusting the request.
#
# Server-only (no NEXT_PUBLIC_ prefix), so it is read at runtime and never
# inlined into a browser bundle. Changing it in Vercel needs a REDEPLOY to take,
# because env vars are bound per deployment.
#
# Must be a BARE origin — scheme + host + optional port, no trailing path,
# query or fragment. https is required except on localhost/127.0.0.1.
#
#   production   https://app.samnewyork.com
#   preview      the preview deployment's own origin
#   development  http://localhost:3000
APP_PUBLIC_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Anthropic Claude (architecture.md #3 — misconception classifier in v1)
# ---------------------------------------------------------------------------

# Server-only. Called against api.anthropic.com directly via @ai-sdk/anthropic
# (no Vercel AI Gateway). Required when MISCONCEPTION_CLASSIFIER_LIVE=true.
# NEVER expose to the browser.
ANTHROPIC_API_KEY=

# Feature flag for real Anthropic API calls. 'false' returns a deterministic
# stub from the classifier's LLM client; only the literal string 'true'
# enables live calls.
#
# M2 readiness (2026-05-28): cleared to go live. The child never interacts
# with the model directly (responses are classified server-side from
# structured data — never free child text), the age gate is satisfied by
# verifiable parental consent (enforced by the /coppa consent gate, not child
# self-attestation), and the AI-processing disclosure is shown in the consent
# flow. Live calls remain fail-soft (classify() degrades to method='failed' on
# any API error).
#
# Default OFF in this template. Production sets it explicitly to 'true' in the
# Vercel dashboard (alongside ANTHROPIC_API_KEY) — never commit it as 'true'
# in this file.
MISCONCEPTION_CLASSIFIER_LIVE=false

# Feature flag for real Anthropic API calls in the report narration generator.
# 'false' (default) returns a deterministic stub JSON; only the literal string
# 'true' enables live Sonnet calls. Flip in Vercel env once the DPA lands.
# REPORT_NARRATION_LIVE=true

# ---------------------------------------------------------------------------
# §12 staged-rollout feature flags (strategy §12)
# ---------------------------------------------------------------------------
# ALL default OFF. Absent (or anything other than the literal string 'true')
# reads as off. Do NOT globally enable a high-risk feature before its milestone
# gate. Several gate features that are not built yet — the flag is an inert
# guard until the feature lands. The two data-sharing flags additionally
# require explicit parent opt-in + counsel review (G3) before going live; the
# flag is a guard, not an authorisation to share child data.
# ENABLE_SHORT_TEST_BETA=true
# ENABLE_COMPREHENSIVE_PILOT=true
# ENABLE_CENTER_ROUTING=true
# ENABLE_EXTERNAL_CENTERS=true
# ENABLE_DIAGNOSTIC_SNAPSHOT_SHARING=true
# ENABLE_FULL_HISTORY_SHARING=true
# ENABLE_MACHINE_GENERATED_ITEMS=true
# ENABLE_INSTRUCTOR_ASSIGNED_PRACTICE=true
# ENABLE_SOCRATIC_ASSISTANT=true
# ENABLE_MULTI_TENANT=true
# ENABLE_FRANCHISOR_DASHBOARD=true

# ---------------------------------------------------------------------------
# Non-§12 UI/QA flags (default OFF; only the literal 'true' enables)
# ---------------------------------------------------------------------------
# Parent intro / instructions screen before the short assessment
# (age-dependent proctoring instructions + about-this-check). When off, the
# assessment auto-starts unchanged. Set 'true' to surface it for QA.
# ENABLE_PARENT_INTRO=true

# Beta welcome screen at the very start of the assessment flow (before the
# parent intro), shown every session. Default ON for the pilot — only the
# literal 'false' turns it OFF. At v1.0 set 'false' to remove the screen with
# no code change.
# BETA_WELCOME_LIVE=false

# ---------------------------------------------------------------------------
# Resend (uncomment when wiring up email — architecture.md #9)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=

# Short-test follow-up lead notification (Resend). Default OFF + fail-soft: the
# lead always persists; the email only sends when LEAD_NOTIFY_LIVE='true' AND
# the key + addresses are set. Leave off until ready to notify the pilot center.
# LEAD_NOTIFY_LIVE=true
# LEAD_NOTIFY_TO_EMAIL=         # pilot center inbox (lead notifications)
# LEAD_NOTIFY_FROM_EMAIL=       # verified Resend sender address

# Staff assessment alerts (Resend) — src/lib/staffAlerts/. Two operational
# emails to the center: a parent CONFIRMED their email (account created), and a
# child COMPLETED an assessment. Reuses RESEND_API_KEY + LEAD_NOTIFY_FROM_EMAIL
# and the SAME LEAD_NOTIFY_LIVE gate as the lead notifier above — there is no
# separate on/off flag.
#
# The recipient has a CODE DEFAULT (parents@samnewyork.com), so nothing needs
# setting in Vercel for these to work once LEAD_NOTIFY_LIVE is on. Set
# STAFF_ALERT_TO only to override it (e.g. route alerts to a QA inbox).
#
# Payloads are an explicit typed allowlist (COPPA): parent name/email, child
# GRADE, and an internal record link. Never a score, level, or child name.
# STAFF_ALERT_TO=parents@samnewyork.com

# Collect the child's SCHOOL on the follow-up form. Default ON: counsel cleared
# collecting the school (coppa-disclosure-v1). Set to 'false' to turn the field
# off — then it is not rendered, not required, and persists NULL (enforced
# server-side in followUp/submit.ts).
# LEAD_SCHOOL_FIELD_LIVE=false

# ---------------------------------------------------------------------------
# Marketing attribution (GA4 + Meta Pixel) — src/lib/marketing/
# ---------------------------------------------------------------------------
#
# Both are PUBLIC (inlined into browser bundles) and both FAIL SAFE: leave them
# unset and the trackers render nothing and no-op. Set them in the Vercel
# dashboard for Production + Preview; leaving them out of .env.local keeps
# local dev out of the reporting.
#
# GA4 is configured with cookie_domain 'auto' so the cookie lands on the
# registrable domain (samnewyork.com) and sessions stitch across
# www.samnewyork.com and the app subdomain. Google Signals and ads
# personalization are disabled in code (COPPA) — also leave Google Signals OFF
# in GA4 Admin -> Data Settings for this property.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-VEEHTL66LR

# Meta Pixel. Loads on parent-facing surfaces ONLY — never on the child
# assessment route (enforced by src/components/marketing/marketing-analytics.
# test.ts).
# NEXT_PUBLIC_META_PIXEL_ID=1351380140193716

# ---------------------------------------------------------------------------
# Tenant white-label branding — src/lib/branding/
# ---------------------------------------------------------------------------
#
# Selects which tenant skin the CUSTOMER-facing surface renders (marketing,
# auth, child assessment, parent dashboard/report, instructor portal, and
# transactional email sender identity). Internal Inspirea chrome — the (admin)
# route group and /dev — is unaffected and keeps Atlas branding.
#
# Valid values are the registry keys in src/lib/branding/index.ts:
#   sam-new-york  (default) — the S.A.M New York skin, live on app.samnewyork.com
#   atlas                   — Inspirea's own Atlas product brand
#
# Unset or unknown falls back to sam-new-york. Adding a franchisee skin is a
# new file in src/lib/branding/tenants/ + a registry line + this var — never a
# component change.
# NEXT_PUBLIC_TENANT_BRAND=sam-new-york
