# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Supabase CLI Studio state
supabase/snippets/

# Throwaway exploration scripts (seed scripts for visual gates, etc.)
tmp/

# Relay review payloads (local-only diffs/findings — never committed)
tools/relay/.reviews/

# Python bytecode caches (e.g. from code_relay.py py_compile checks)
__pycache__/
*.pyc

# Claude Code config: shared governance (agents, hooks, settings.json,
# relay-agent.settings.json) is committed; everything else under .claude/
# stays per-developer.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
!.claude/relay-agent.settings.json


