# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Supabase CLI Studio state
supabase/snippets/

# Throwaway exploration scripts (seed scripts for visual gates, etc.)
tmp/

# Relay review payloads (local-only diffs/findings — never committed)
tools/relay/.reviews/

# L1 art extraction output — crops live in Supabase Storage (question-images/l1/);
# page renders / raw media / the rebuilt PDF are bulky, generated, and regenerable
# from scripts/conversion/l1_*.py against the source .docx.
scripts/conversion/output/l1-art/

# Licensed S.A.M. source — placement-worksheet docx + per-question crops live
# ONLY here, untracked (licensed assets; never commit). Derived audit artifacts
# that carry the worksheet skill/topic text are excluded for the same reason.
scripts/conversion/source/
scripts/conversion/audit/source-short-keys.json
scripts/conversion/audit/_short_err.txt
scripts/conversion/audit/_matrix.md

# Claude Code config: shared governance (agents, hooks, settings.json) is
# committed; everything else under .claude/ stays per-developer.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json


